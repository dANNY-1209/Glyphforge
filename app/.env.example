# JWT Configuration
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=30d

# Bootstrap super-admin Discord ID. This user is always admin, cannot be demoted,
# and is the recovery handle if admins.json is wiped.
SUPER_ADMIN_DISCORD_ID=000000000000000000

# Webhook Configuration (for new request notifications — legacy Clawdbot path)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/webhook
WEBHOOK_SECRET=your-webhook-secret

# Discord OAuth2 (the only login path)
# Get these from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://your-domain.com/api/auth/discord/callback

# Discord channel webhook for "new content" notifications.
# Create one in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Leave unset / empty to disable notifications.
DISCORD_WEBHOOK_URL=

# Public base URL (used for absolute image URLs in Discord embeds)
PUBLIC_BASE_URL=https://your-domain.com

# MizuCanvas auto-sync (optional cross-app integration).
# When enabled, new/updated character LoRAs are also pushed to a MizuCanvas
# instance as public LoRAs (one row per meta.model[] entry whose name maps
# to Anima / Illustrious). Failures are silent (only logged + Discord webhook).
# Leave MIZUCANVAS_SYNC_ENABLED unset or != 'true' to disable.
MIZUCANVAS_SYNC_ENABLED=false
MIZUCANVAS_API_URL=https://mizucanvas.example.com
MIZUCANVAS_API_KEY=
